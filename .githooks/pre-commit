#!/bin/sh
#
# Refuses a commit made without a git identity, or one that does not analyze
# cleanly or does not pass the tests.
#
# This is not enabled by cloning. Turn it on once per checkout with:
#
#     git config core.hooksPath .githooks
#
# It is also the gate `bl close` runs before delivering a task, which is what
# makes "new code comes with tests" enforce itself rather than rely on review.
#
# Skip it deliberately with `git commit --no-verify` when you are committing
# something that genuinely cannot build — a partial rebase, a docs fixup in the
# middle of a conflict. Do not make a habit of it.

set -e

# An identity first, before anything else this hook does.
#
# Git does not require one. With `user.name` and `user.email` unset it invents
# an author from the operating system -- the full name in the account record
# plus `$USER@$(hostname)` -- and commits perfectly happily under an address
# that belongs to no GitHub account. A squash merge then attributes that
# stranger as a co-author of the commit that lands on master, and the repository
# grows a `Co-authored-by:` trailer that AGENTS.md forbids outright. Two of them
# reached master this way, both delivered by `bl`, whose worktrees inherit
# whatever identity the shell that ran them had -- which for an agent is
# routinely none.
#
# The exit status is the whole test. `git config user.email` fails when nothing
# sets it, which is exactly the state that produces a synthesized author and no
# other. Matching the invented address by shape -- a hostname, a missing dot in
# the domain -- would refuse people whose real address happens to look like
# that, and would be fooled the moment the machine is renamed.
#
# This runs before the flutter check and before the prose skip because a commit
# with no identity is wrong whatever it contains: a typo fix carries the same
# bad author into the same trailer as a rewrite of the app. It is also the
# reason `bl close` cannot deliver one, which is the point.
committer_name=$(git config user.name || true)
committer_email=$(git config user.email || true)

if [ -z "$committer_name" ] || [ -z "$committer_email" ]; then
  echo "pre-commit: this repository has no git identity configured, so git" >&2
  echo "would invent one from your account and hostname. GitHub does not" >&2
  echo "recognise that address, and squash merging turns it into a" >&2
  echo "Co-authored-by: trailer on master, which AGENTS.md forbids." >&2
  echo "" >&2
  echo "  git config user.name 'Your Name'" >&2
  echo "  git config user.email 'ID+login@users.noreply.github.com'" >&2
  echo "" >&2
  echo "Your noreply address is on https://github.com/settings/emails." >&2
  echo "Use --global to set it once for every checkout on this machine." >&2
  exit 1
fi

if ! command -v flutter >/dev/null 2>&1; then
  echo "pre-commit: flutter is not on PATH, skipping analyze and tests." >&2
  exit 0
fi

changed=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$changed" ]; then
  exit 0
fi

# A commit touching only prose cannot break the build, and paying a full test
# run for a typo fix is how hooks end up disabled permanently.
if ! printf '%s\n' "$changed" | grep -qvE '\.(md|txt)$|^docs/'; then
  exit 0
fi

# Git points every hook at the repository being committed to by exporting
# GIT_DIR, and the flutter tool shells out to git to discover its OWN version.
# GIT_DIR outranks the `-C <flutter root>` flutter passes, so it reads this
# repository, finds no Flutter tag, calls itself 0.0.0-unknown, rebuilds the
# flutter tool and then fails pub resolution -- because no SDK constraint can
# be satisfied by an unknown version -- all before analyze has run once. The
# error names a package, so nothing about it points at the hook.
#
# This has to come after the staged file list is read, not before: a partial
# commit or `git commit -a` builds a temporary index and tells the hook about
# it through GIT_INDEX_FILE, so clearing the environment any earlier makes
# `git diff --cached` inspect the wrong content instead.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR

echo "pre-commit: flutter analyze"
flutter analyze

echo "pre-commit: flutter test"
flutter test
