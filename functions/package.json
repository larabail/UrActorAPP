{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test \"test/*.test.js\"",
    "test:emulator": "npx --yes firebase-tools@15.28.1 emulators:exec --config ../firebase.json --project demo-uractor-functions-test --only firestore,functions,pubsub \"node --test \\\"test/*.test.js\\\"\""
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.0"
  },
  "private": true
}
